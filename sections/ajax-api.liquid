<div class="cart-content"></div>

<script>

  async function getCart() {
    const cartRequest = await fetch(`${window.Shopify.routes.root}/cart.js`);
    const cart = await cartRequest.json();

    return cart;

    const cartContentsDiv = document.querySelector(".cart-content");
          cartContentsDiv.textContent = `Carts total items: ${cart.item_count}`;
  }

  async function addToCart(variantId, quantity) {
    const LINE_ITEM_KEY = "44413356376260:218ef23945774e8af3b82dec44e0c9d";

    const addToCartRequest = await fetch("/cart/add.js", {
      method: "post",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        updates: {
          [LINE_ITEM_KEY]: 5,
        },
        attributes: {
          "cart_test": "cart test"
        },
        note: "This is a test note!"
      })
    });

    window.location.reload();
  }


  console.log(cart);
</script>

